*.log
.qmlls.ini
state.json

# Hyprland local configs (not tracked by git)
hyprland/.config/hypr/local/*
!hyprland/.config/hypr/local/.gitkeep

hyprland/.config/uwsm/env.d/*
!hyprland/.config/uwsm/env.d/.gitkeep

# Local wallpapers (copied from .data/wallpapers/ on installation)
local/.local/wallpapers/*
!local/.local/wallpapers/.gitkeep

# Local themes (copied from .data/themes/ on installation)
local/.local/themes/*
!local/.local/themes/.gitkeep

# Old place of the monitor rules (now hypr/local/monitors.lua, from
# Settings › Hyprland › Monitors); nwg-displays still writes here
hyprland/.config/hypr/monitors.lua
hyprland/.config/hypr/monitors.lua.old
# Generated by the old workspace-manager.sh, removed by migration 023
hyprland/.config/hypr/workspaces.lua

# Each machine's own (the icon theme, the default terminal, qt6ct and KDE
# settings): made from .data/config-defaults/ when missing, see
# .data/lyne-cli/lib/config-defaults.sh
kde/.config/kdeglobals
theming/.config/qt6ct/qt6ct.conf
theming/.config/qt5ct/qt5ct.conf
theming/.config/gtk-3.0/settings.ini
theming/.config/gtk-4.0/settings.ini

# GTK colors.css (generated at runtime by ThemeService/matugen)
theming/.config/gtk-3.0/colors.css
theming/.config/gtk-4.0/colors.css

# Kitty colors (written by ThemeService on every theme change and shell start;
# kitty ignores the missing include until then)
kitty/.config/kitty/current-theme.conf


# Python bytecode (written when the scripts are imported)
__pycache__/

# Dolphin folder settings
.directory
