#!/usr/bin/env bats
# .data/lyne-cli/migrations and lib/run-migrations.sh, on a fake $DOTS_DIR:
# every migration must work on a fresh install and on an old one, and running
# it again must change nothing (lyne update retries a chain that stopped)

load helpers

setup() {
    lyne_setup
    SYS="$BATS_TEST_TMPDIR/sys"
    export LYNE_SYSFS="$SYS" LYNE_PCI_IDS="$FIXTURES/pci.ids" LYNE_UDEV_DIR="$BATS_TEST_TMPDIR/udev"
    export LYNE_PP_BUS_NAMES="" LYNE_PP_COMMANDS="" LYNE_PP_POWER_SUPPLY="$BATS_TEST_TMPDIR/power_supply"
    mkdir -p "$LYNE_UDEV_DIR" "$LYNE_PP_POWER_SUPPLY"
    fx_gpu "$SYS" 0000:01:00.0 10de:1f9d driver=nvidia card=card0 outputs="HDMI-A-1:connected"
    fx_gpu "$SYS" 0000:00:02.0 8086:3e9b driver=i915 card=card1 outputs="eDP-1:connected"
    STATE="$HOME/.config/quickshell/state.json"
}

teardown() { repo_unchanged; }

# migrate NAME: one migration, the way run-migrations.sh runs it
migrate() { in_lyne -- "(source \"\$DOTS_DIR/.data/lyne-cli/migrations/$1\")"; }
chain() { in_lyne run-migrations -- ''; }
state() { jq -c "$1" "$STATE"; }

# An install from before the migrations: old state values and the files
# older versions left in ~/.config/hypr and ~/.local
legacy_home() {
    local hypr="$HOME/.config/hypr" dri="$BATS_TEST_TMPDIR/dev/dri"
    mkdir -p "$hypr/local" "$HOME/.local/themes" "$dri"
    jq '.keybinds.overrides = [{id: "special-spotify", keys: "SUPER + M"}]
        | .keybinds.custom = [{keys: "SUPER + space", command: "rofi -show drun", description: "Rofi"},
                              {keys: "super+b", command: "firefox", description: "Browser"}]
        | .brightness.pollInterval = 60
        | .typography.font = "Caskaydia Cove Nerd Font"
        | .dashboard.holidays = "br"
        | .specials.list[0].command = "zapzap"' "$STATE" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"
    echo 'bind = SUPER, Q, killactive' >"$hypr/local/old_keybinds.conf"
    printf '%s\n' '-- generated by workspace-manager.sh' \
        'hl.workspace_rule({ workspace = "1", monitor = "eDP-1", default = true })' \
        'hl.workspace_rule({ workspace = "101", monitor = "HDMI-A-1", default = true })' >"$hypr/workspaces.lua"
    printf '%s\n' '-- nwg-displays' \
        'hl.monitor({ output = "HDMI-A-1", mode = "1920x1080@179.96", position = "0x0", scale = 1 })' \
        'hl.monitor({ output = "eDP-1", mode = "1920x1080@144", position = "1920x0", scale = 1.25, vrr = 1 })' >"$hypr/monitors.lua"
    echo 'hl.exec_cmd("syncthing")' >"$hypr/local/autostart.lua"
    touch "$dri/card0" "$dri/card1"
    ln -s card0 "$dri/nvidia-dgpu"
    echo "hl.env(\"AQ_DRM_DEVICES\", \"$dri/card1:$dri/nvidia-dgpu\")" >"$hypr/local/extra_environment.lua"
    jq '.wallpaper = "themes/tokyonight/theme-1.jpg"' "$REPO/.data/themes/tokyonight.json" >"$HOME/.local/themes/tokyonight.json"
    # Linked by an old install (every package then); the user's own kitty
    ln -s "$DOTS_DIR/nvim/.config/nvim" "$HOME/.config/nvim"
    ln -s "$DOTS_DIR/zsh/.zshrc" "$HOME/.zshrc"
    mkdir -p "$HOME/.config/kitty"
    echo mine >"$HOME/.config/kitty/kitty.conf"
}

@test "fresh install: each migration succeeds, and again changes nothing" {
    fake_dots
    local m name before after failed=()
    for m in "$DOTS_DIR"/.data/lyne-cli/migrations/*.sh; do
        name="${m##*/}"
        run migrate "$name"
        [[ $status -eq 0 ]] || { failed+=("$name (status $status): $output"); continue; }
        before="$(snapshot)"
        run migrate "$name"
        [[ $status -eq 0 ]] || { failed+=("$name (second run, status $status): $output"); continue; }
        after="$(snapshot)"
        [[ "$before" == "$after" ]] || failed+=("$name changed things on its second run: $(diff <(echo "$before") <(echo "$after"))")
    done
    printf '%s\n' "${failed[@]}"
    assert_equal "${#failed[@]}" 0
}

@test "old install: the whole chain runs, and a second run changes nothing" {
    fake_dots
    legacy_home
    run chain
    assert_success
    refute_output --partial "failed"
    local done_file="$HOME/.local/share/lyne/migrations-done"
    assert_equal "$(wc -l <"$done_file")" "$(find "$REPO/.data/lyne-cli/migrations" -name '*.sh' | wc -l)"
    run chain
    assert_output --partial "No pending migrations"

    # Everything again from the start (a lost migrations-done)
    local before
    before="$(snapshot | grep -v migrations-done)"
    : >"$done_file"
    run chain
    assert_success
    assert_equal "$(snapshot | grep -v migrations-done)" "$before"
}

@test "old install: what the chain carries over" {
    fake_dots
    legacy_home
    run chain
    assert_success
    local hypr="$HOME/.config/hypr"
    # State values renamed or retired
    assert_equal "$(state '[.keybinds.overrides[].id]')" '["special-music","switch-layout","wallpapers"]'
    assert_equal "$(state '.brightness.pollInterval')" 0
    assert_equal "$(state '.typography.font')" '"CaskaydiaCove Nerd Font"'
    assert_equal "$(state '.dashboard.holidays')" '"auto"'
    assert_equal "$(state '.specials.list[0].command')" '"lyne whatsapp"'
    # nwg-displays monitors: imported, then moved to local/
    assert_equal "$(state '[.monitors.rules[] | [.output, .scale]]')" '[["HDMI-A-1",1],["eDP-1",1.25]]'
    assert [ -f "$hypr/local/monitors.lua" ]
    refute [ -e "$hypr/monitors.lua" ]
    # Old workspace blocks kept in Hyprland's state
    grep -q '{ slot = 0, desc = "", name = "eDP-1" }' "$HOME/.local/state/lyne/workspace-monitors.lua"
    grep -q '{ slot = 1, desc = "", name = "HDMI-A-1" }' "$HOME/.local/state/lyne/workspace-monitors.lua"
    refute [ -e "$hypr/workspaces.lua" ]
    # Legacy .conf backed up, not translated
    refute [ -e "$hypr/local/old_keybinds.conf" ]
    compgen -G "$hypr/pre-lua-backup-*/old_keybinds.conf"
    # No Hyprland running: the autostart file stays and keeps working
    assert [ -f "$hypr/local/autostart.lua" ]
    # GPU order from the hand-written AQ_DRM_DEVICES, its line commented out
    assert_equal "$(state '.gpus.order')" '["0000:00:02.0","0000:01:00.0"]'
    grep -q '^-- Set in local/gpus.lua now (lyne gpu order): hl.env("AQ_DRM_DEVICES"' "$hypr/local/extra_environment.lua"
    grep -q '"/dev/dri/intel-igpu",' "$hypr/local/gpus.lua"
    assert [ -f "$LYNE_UDEV_DIR/90-lyne-gpus.rules" ]
    # The packages linked are recorded (hypr is a real folder here), none
    # unlinked
    assert_equal "$(state '.system.stow')" '["quickshell","nvim","zsh"]'
    assert [ -L "$HOME/.zshrc" ]
    assert [ -f "$HOME/.config/kitty/kitty.conf" ]
    # Theme on its old default wallpaper moves to the new one
    assert_equal "$(jq -r .wallpaper "$HOME/.local/themes/tokyonight.json")" "themes/tokyonight/lyne-tokyonight-contour.jpg"
}

@test "041: an old lyne-editor.desktop gets the app's name and icon" {
    fake_dots
    local share="$BATS_TEST_TMPDIR/share/applications" wrapper="$HOME/.local/share/applications/lyne-editor.desktop"
    mkdir -p "$share" "$(dirname "$wrapper")"
    printf '%s\n' '[Desktop Entry]' 'Name=Neovim' 'Icon=nvim' 'Terminal=true' >"$share/nvim.desktop"
    printf '%s\n' '[Desktop Entry]' 'Name=nvim (lyne editor)' 'Exec=x term nvim %F' 'MimeType=text/plain;' >"$wrapper"
    jq '.system.editor = "nvim"' "$STATE" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"
    XDG_DATA_DIRS="$BATS_TEST_TMPDIR/share" run migrate 041-default-app-icons.sh
    assert_success
    run cat "$wrapper"
    assert_line "Name=Neovim (lyne editor)"
    assert_line "Icon=nvim"
}

@test "038: a list already recorded (a new install) stays" {
    fake_dots
    ln -s "$DOTS_DIR/zsh/.zshrc" "$HOME/.zshrc"
    jq '.system.stow = ["hyprland", "quickshell", "local"]' "$STATE" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"
    run migrate 038-record-stowed-packages.sh
    assert_success
    assert_output ""
    assert_equal "$(state '.system.stow')" '["hyprland","quickshell","local"]'
}

@test "039: polkit-kde-agent always, kitty while it's the default terminal" {
    fake_dots
    pkgs hyprpolkitagent
    run migrate 039-core-kitty-polkit.sh
    assert_success
    assert_output "   Installing polkit-kde-agent kitty..."
    grep -q "^kitty " "$FAKE_PKGS" && grep -q "^polkit-kde-agent " "$FAKE_PKGS"
    # Nothing uninstalled
    grep -q "^hyprpolkitagent " "$FAKE_PKGS"
    run migrate 039-core-kitty-polkit.sh
    assert_output "   polkit-kde-agent kitty already installed, skipping"
}

@test "039: another default terminal doesn't get kitty" {
    fake_dots
    jq '.apps.terminal.command = "foot"' "$STATE" >"$STATE.tmp" && mv "$STATE.tmp" "$STATE"
    run migrate 039-core-kitty-polkit.sh
    assert_success
    assert_output "   Installing polkit-kde-agent..."
    refute grep -q "^kitty " "$FAKE_PKGS"
}

@test "040: lazygit comes with Neovim (the editor packages)" {
    fake_dots
    pkgs neovim
    run migrate 040-lazygit.sh
    assert_success
    assert_output "   Installing lazygit..."
    grep -q "^lazygit " "$FAKE_PKGS"
    run migrate 040-lazygit.sh
    assert_output "   lazygit already installed, skipping"
}

@test "040: no Neovim, no lazygit" {
    fake_dots
    run migrate 040-lazygit.sh
    assert_success
    assert_output ""
    refute grep -q "^lazygit " "$FAKE_PKGS"
}

@test "a migration with nothing to convert says nothing" {
    fake_dots
    run migrate 018-special-workspaces-ids.sh
    assert_success
    assert_output ""
}

@test "nothing outside the temp dir is touched: /etc writes are refused, modprobe is a stand-in" {
    fake_dots
    run migrate 013-install-ddcutil.sh
    assert_success
    run cat "$STUB_LOG"
    if grep -q 'i2c-dev.conf' "$STUB_LOG"; then
        assert_line "sudo-refused tee /etc/modules-load.d/i2c-dev.conf"
        assert_line "modprobe i2c-dev"
    fi
    refute_output --partial "sudo-refused rm"
}

@test "runner: in order, stops at a failing migration and retries it next time" {
    local dir="$BATS_TEST_TMPDIR/migrations"
    mkdir -p "$dir"
    echo 'echo one >>"$HOME/ran"' >"$dir/001-one.sh"
    echo 'echo two >>"$HOME/ran"; [[ -f "$HOME/fixed" ]]' >"$dir/002-two.sh"
    echo 'echo three >>"$HOME/ran"' >"$dir/003-three.sh"
    printf 'cd /\nlocal leaked=1\nexit 0\n' >"$dir/004-exit.sh"
    fake_dots "$dir"
    run chain
    assert_failure
    assert_output --partial "migration '002-two.sh' failed, stopping"
    assert_equal "$(cat "$HOME/ran" | xargs)" "one two"
    assert_equal "$(cat "$HOME/.local/share/lyne/migrations-done")" "001-one.sh"
    touch "$HOME/fixed"
    run in_lyne run-migrations -- 'echo "pwd=$PWD leaked=${leaked:-no}"'
    assert_success
    assert_equal "$(cat "$HOME/ran" | xargs)" "one two two three"
    # An exit or a cd in a migration stays in it
    assert_line "pwd=$PWD leaked=no"
    assert_equal "$(xargs <"$HOME/.local/share/lyne/migrations-done")" "001-one.sh 002-two.sh 003-three.sh 004-exit.sh"
}

@test "migrations are numbered and their numbers unique" {
    run bash -c 'ls "$1" | grep -vE "^[0-9]{3}-[a-z0-9-]+\.sh$"' _ "$REPO/.data/lyne-cli/migrations"
    assert_output ""
    run bash -c 'ls "$1" | cut -c1-3 | uniq -d' _ "$REPO/.data/lyne-cli/migrations"
    assert_output ""
}
